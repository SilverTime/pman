{
  "rate_limit": { "req_per_min": 60 },
  "allow": [
    { "site": "gitlab", "methods": ["GET"], "paths": ["/api/v4/projects/**", "/api/v4/groups/**", "/api/v4/version"] },
    { "site": "wiki", "methods": ["GET"], "paths": ["/**"] }
  ],
  "approval": { "required_for": [] },
  "redact": {
    "strip_headers": ["set-cookie", "authorization", "x-api-key"],
    "json_keys": ["(?i).*token.*", "(?i).*password.*", "(?i).*secret.*", "(?i).*cookie.*"],
    "max_response_bytes": 524288
  }
}
